# Copy to .env and adjust if needed. The defaults match docker-compose.yaml.
# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
# Best practice: pre-register schemas and set this to false in production.
SCHEMA_AUTO_REGISTER=true
CONSUMER_GROUP=warehouse-loader
TOPIC_ORDERS=orders.events.v1
TOPIC_PAYMENTS=payments.events.v1
TOPIC_CUSTOMERS=customers.cdc.v1
DLQ_SUFFIX=.dlq

# ---------- PostgreSQL warehouse ----------
# Inside the Docker network the database listens on 5432.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
# Host port. 5434 so it does not collide with project 1 (5433).
POSTGRES_HOST_PORT=5434

# ---------- Loader behaviour ----------
BATCH_SIZE=500
MAX_LATENESS_SECONDS=3600
CONSUME_IDLE_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO

# ---------- dbt runner ----------
DBT_REFRESH_SECONDS=300

# ---------- dashboard ----------
# Set to 0 to start the monitoring dashboard with auto-refresh disabled
# (used by the headless render check and handy for screenshots).
DASHBOARD_AUTO_REFRESH=1
