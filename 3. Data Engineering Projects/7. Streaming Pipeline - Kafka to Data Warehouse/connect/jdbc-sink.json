{
  "name": "jdbc-sink-orders",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "orders.events.v1",
    "connection.url": "jdbc:postgresql://postgres:5432/warehouse",
    "connection.user": "warehouse",
    "connection.password": "warehouse",

    "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",

    "table.name.format": "landing.orders_connect",
    "auto.create": "true",
    "auto.evolve": "true",
    "pk.mode": "record_key",
    "pk.fields": "order_id",
    "insert.mode": "upsert",
    "delete.enabled": "false",

    "fields.whitelist": "order_id,customer_id,store_id,status,currency,amount,item_count,event_time",
    "db.timezone": "UTC",
    "batch.size": "500",
    "max.retries": "10",
    "retry.backoff.ms": "3000",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "orders.events.v1.dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}
