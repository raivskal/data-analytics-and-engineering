<mxfile host="app.diagrams.net" type="device"><diagram id="04-agent-patterns" name="Google ADK agent patterns: sequential, parallel and loop"><mxGraphModel dx="1200" dy="637" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="637" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="band-0" value="SEQUENTIAL AGENT · FIXED ORDER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=#F6F9FC;strokeColor=#C9D8E4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=9;fontColor=#8AA0B3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="26" width="740" height="150" as="geometry"/></mxCell><mxCell id="band-1" value="PARALLEL AGENT · FAN-OUT, THEN SYNTHESISE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=#F6F9FC;strokeColor=#C9D8E4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=9;fontColor=#8AA0B3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="357" y="232" width="486" height="163" as="geometry"/></mxCell><mxCell id="band-2" value="LOOP AGENT · ITERATE UNTIL ACCEPTED" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=#F6F9FC;strokeColor=#C9D8E4;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=9;fontColor=#8AA0B3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="451" width="740" height="150" as="geometry"/></mxCell><mxCell id="n-0-v" value="&lt;b&gt;validator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f7889&quot;&gt;checks the input&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1a73e8;strokeWidth=1.5;fontSize=13;fontStyle=1;fontColor=#16323F;align=center;verticalAlign=bottom;spacingBottom=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="246" y="56" width="200" height="104" as="geometry"/></mxCell